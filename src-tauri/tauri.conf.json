{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sovereign",
  "version": "1.0.1",
  "identifier": "com.sovereign.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
"app": {
    "windows": [
      {
        "title": "Sovereign",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: asset: http://asset.localhost; font-src 'self' data:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/com.sovereign.app/**",
          "$APPDATA/com.sovereign.app/screenshots/**"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/lehendo/sovereign/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "$TAURI_PUBLIC_KEY"
    }
  }
}

